# CreatorOS AI - Docker Environment Configuration
# Copy this file to .env and fill in the secrets

# ==============================================================================
# Database Configuration
# ==============================================================================
# In Docker, we connect to the 'postgres' service
DATABASE_URL=postgresql+asyncpg://creatoros:creatoros_pass@postgres:5432/creatoros_db

# ==============================================================================
# Redis Configuration
# ==============================================================================
# In Docker, we connect to the 'redis' service
REDIS_URL=redis://redis:6379/0

# ==============================================================================
# Application Security
# ==============================================================================
# Generate a secure key for sessions/tokens (e.g., python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=YOUR_SECRET_KEY_HERE
# Generate a Fernet key for encrypting social tokens (e.g., from cryptography.fernet import Fernet; print(Fernet.generate_key().decode()))
ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE

# ==============================================================================
# AI Provider Configuration
# ==============================================================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ==============================================================================
# Application Settings
# ==============================================================================
ENVIRONMENT=development
# IMPORTANT: DEV_AUTH_BYPASS must be false or commented out in production environments.
# DEV_AUTH_BYPASS=false

# ==============================================================================
# MCP (Model Context Protocol) Configuration
# ==============================================================================
MCP_SOCIAL_SERVER_COMMAND=python -m app.mcp.servers.social
MCP_RESEARCH_SERVER_COMMAND=python -m app.mcp.servers.research
# Add any required API keys for MCP research tools here
# TAVILY_API_KEY=your_tavily_api_key_here

# ==============================================================================
# OAuth Configuration (for Social Connect)
# ==============================================================================
# Bluesky OAuth is handled via MCP adapter or specific implementation
# Add other platform credentials as needed
