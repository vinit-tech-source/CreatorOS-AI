# ── Local development overrides ───────────────────────────────────────────
# This file is gitignored. Do NOT commit it.
#
# To enable the dev auth bypass:
#   1. Set VITE_DEV_AUTH_BYPASS=true here
#   2. Set DEV_AUTH_BYPASS=true in backend/.env
#   3. Restart both servers
#
# To disable: set both back to false (or delete this file).
# ─────────────────────────────────────────────────────────────────────────

VITE_DEV_AUTH_BYPASS=false
